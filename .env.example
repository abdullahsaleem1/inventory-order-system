ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inventory_orders
READ_DATABASE_URL=

REDIS_URL=redis://redis:6379/0

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes — the app refuses to boot with a shorter key.
JWT_SECRET_KEY=dev-only-insecure-please-change-me-0123456789
JWT_ALGORITHM=HS256
JWT_ISSUER=inventory-order-system
JWT_AUDIENCE=inventory-order-system-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BROKER_URL=

# pgAdmin (management UI, http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin