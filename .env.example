ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inventory_orders

# CQRS read store (Week 7). LEFT EMPTY = single-database CQRS (read side shares
# the primary DB). Set to a dedicated read-optimized DB to serve queries from a
# separate store. The read side only needs the projection tables.
#   e.g. READ_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inventory_orders_read
READ_DATABASE_URL=

# CQRS dedicated read store (Week 8). ORDER QUERY HANDLERS READ EXCLUSIVELY
# FROM THIS STORE. "inmemory" is the zero-dependency fallback (tests/local);
# "elasticsearch" is the production store brought up by docker-compose.
#   Local dev (no containers):  READ_STORE_TYPE=inmemory
#   Docker Compose sets:        READ_STORE_TYPE=elasticsearch READ_STORE_URL=http://elasticsearch:9200
READ_STORE_TYPE=inmemory
READ_STORE_URL=
READ_STORE_INDEX=orders

REDIS_URL=redis://redis:6379/0

# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes — the app refuses to boot with a shorter key.
JWT_SECRET_KEY=dev-only-insecure-please-change-me-0123456789
JWT_ALGORITHM=HS256
JWT_ISSUER=inventory-order-system
JWT_AUDIENCE=inventory-order-system-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# RabbitMQ message broker (Week 5). Empty = events disabled (POST /orders -> 503).
# Local dev:   amqp://guest:guest@localhost:5672/
# Docker Compose sets this automatically to the rabbitmq container.
BROKER_URL=
EVENT_EXCHANGE=inventory.orders.events
ORDER_CREATED_ROUTING_KEY=order.created
ORDER_STATUS_CHANGED_ROUTING_KEY=order.status.changed
ORDERS_PERSISTENCE_QUEUE=orders.order-created.persistence
ORDERS_AUDIT_QUEUE=orders.order-created.audit
ORDERS_INVENTORY_QUEUE=orders.order-created.inventory
ORDERS_READ_QUEUE=orders.order-created.read
DEAD_LETTER_EXCHANGE=inventory.orders.dlx
CONSUMER_PREFETCH_COUNT=10
CONSUMER_MAX_RETRIES=3
# Exponential backoff (Week 6): delay = base * 2^(attempt-1), capped at max.
CONSUMER_BACKOFF_BASE_SECONDS=1.0
CONSUMER_BACKOFF_MAX_SECONDS=60.0

# pgAdmin (management UI, http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin