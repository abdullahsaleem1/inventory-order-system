{
  "info": {
    "name": "Inventory & Order Management System",
    "description": "Auth (register/login/OAuth2 token/me) added in Week 3. Health/readiness, Inventory and Orders endpoints included from earlier weeks. Set {{accessToken}} via a Login request script to call protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Liveness - GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Returns 200 as long as the process is running. Never touches the database."
          }
        },
        {
          "name": "Readiness - GET /ready",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/ready", "host": ["{{baseUrl}}"], "path": ["ready"] },
            "description": "Returns 200 if the DB is reachable, 503 otherwise."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register - POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"full_name\": \"Alice Smith\",\n  \"password\": \"S3curePass!\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "description": "Creates a user and returns the profile plus a short-lived Bearer access token. Password min 8 chars."
          }
        },
        {
          "name": "Login - POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"S3curePass!\"\n}" },
            "description": "Exchanges email+password for a short-lived access token. Saves the token into the {{accessToken}} collection variable for protected calls.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "const json = pm.response.json();",
                    "if (pm.response.code === 200 && json.access_token) {",
                    "  pm.collectionVariables.set('accessToken', json.access_token);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          }
        },
        {
          "name": "OAuth2 Token - POST /oauth/token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "url": { "raw": "{{baseUrl}}/oauth/token", "host": ["{{baseUrl}}"], "path": ["oauth", "token"] },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "username", "value": "alice@example.com" },
                { "key": "password", "value": "S3curePass!" }
              ]
            },
            "description": "OAuth2.0 Resource Owner Password Credentials grant. Same token response as /auth/login."
          }
        },
        {
          "name": "Me - GET /auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] },
            "description": "Returns the currently authenticated user. Requires a valid Bearer access token (set by running Login first)."
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/inventory/products", "host": ["{{baseUrl}}"], "path": ["inventory", "products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"EL-0001\",\n  \"name\": \"Wireless Mouse\",\n  \"price_cents\": 2999,\n  \"quantity_on_hand\": 100\n}"
            }
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/products?limit=100&offset=0", "host": ["{{baseUrl}}"], "path": ["inventory", "products"], "query": [{ "key": "limit", "value": "100" }, { "key": "offset", "value": "0" }] }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/inventory/products/:productId", "host": ["{{baseUrl}}"], "path": ["inventory", "products", ":productId"], "variable": [{ "key": "productId", "value": "" }] }
          }
        },
        {
          "name": "Reserve Stock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/inventory/products/:productId/reserve", "host": ["{{baseUrl}}"], "path": ["inventory", "products", ":productId", "reserve"], "variable": [{ "key": "productId", "value": "" }] },
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1\n}" }
          }
        },
        {
          "name": "Restock",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/inventory/products/:productId/restock", "host": ["{{baseUrl}}"], "path": ["inventory", "products", ":productId", "restock"], "variable": [{ "key": "productId", "value": "" }] },
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 10\n}" }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"lines\": [\n    { \"product_id\": \"00000000-0000-0000-0000-000000000000\", \"quantity\": 1, \"unit_price_cents\": 2999 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/orders/:orderId", "host": ["{{baseUrl}}"], "path": ["orders", ":orderId"], "variable": [{ "key": "orderId", "value": "" }] }
          }
        },
        {
          "name": "Confirm Order",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/:orderId/confirm", "host": ["{{baseUrl}}"], "path": ["orders", ":orderId", "confirm"], "variable": [{ "key": "orderId", "value": "" }] }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/orders/:orderId/cancel", "host": ["{{baseUrl}}"], "path": ["orders", ":orderId", "cancel"], "variable": [{ "key": "orderId", "value": "" }] }
          }
        }
      ]
    }
  ]
}